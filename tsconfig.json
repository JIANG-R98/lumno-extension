{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "chrome",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
