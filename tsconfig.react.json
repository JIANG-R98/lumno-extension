{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome",
      "vite/client",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/react/**/*.ts",
    "src/**/react/**/*.tsx",
    "tests/react/**/*.ts",
    "vite.config.mjs",
    "vite.overlay.config.mjs",
    "vitest.config.ts",
    "src/types/**/*.d.ts"
  ]
}
