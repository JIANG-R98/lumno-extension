{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/popup/**/*.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
