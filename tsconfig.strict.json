{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/onboarding/**/*.ts",
    "src/popup/**/*.ts",
    "src/newtab/cross-surface-drag.ts",
    "src/newtab/dismiss-stack.ts",
    "src/newtab/drag-click-guard.ts",
    "src/newtab/layout-motion.ts",
    "src/newtab/newtab-types.ts",
    "src/newtab/remote-content.ts",
    "src/newtab/remote-content-types.ts",
    "src/newtab/section-mode-select.ts",
    "src/newtab/storage-change-registry.ts",
    "src/newtab/appearance-modes.ts",
    "src/newtab/clipboard-actions.ts",
    "src/newtab/entry-motion.ts",
    "src/newtab/feedback-control.ts",
    "src/newtab/focus-resume.ts",
    "src/newtab/input-focus.ts",
    "src/newtab/newtab-focus-entry.ts",
    "src/newtab/lumno-newtab.ts",
    "src/newtab/mode-commands.ts",
    "src/newtab/newtab-route-redirect.ts",
    "src/newtab/newtab-storage-prefetch.ts",
    "src/newtab/page-keyboard.ts",
    "src/newtab/page-language.ts",
    "src/newtab/page-navigation.ts",
    "src/newtab/page-notices.ts",
    "src/newtab/page-preferences.ts",
    "src/newtab/page-resize.ts",
    "src/newtab/page-state.ts",
    "src/newtab/section-reload.ts",
    "src/newtab/startup-preferences.ts",
    "src/newtab/startup-storage.ts",
    "src/newtab/tooltip-bindings.ts",
    "src/newtab/tooltip-controllers.ts",
    "src/newtab/url-policy.ts",
    "src/newtab/viewport-insets.ts",
    "src/newtab/bookmarks/**/*.ts",
    "src/newtab/recent/**/*.ts",
    "src/newtab/search/**/*.ts",
    "src/newtab/shortcuts/**/*.ts",
    "src/newtab/theme/**/*.ts",
    "src/newtab/top-content/**/*.ts",
    "src/newtab/wallpaper/**/*.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
