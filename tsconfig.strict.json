{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/onboarding/**/*.ts",
    "src/popup/**/*.ts",
    "src/newtab/cross-surface-drag.ts",
    "src/newtab/dismiss-stack.ts",
    "src/newtab/drag-click-guard.ts",
    "src/newtab/newtab-types.ts",
    "src/newtab/bookmarks/bookmark-cascade-actions.ts",
    "src/newtab/bookmarks/bookmark-cascade-menu.ts",
    "src/newtab/bookmarks/bookmark-cascade-position.ts",
    "src/newtab/bookmarks/bookmark-drag.ts",
    "src/newtab/bookmarks/bookmark-folder-icon.ts",
    "src/newtab/bookmarks/bookmark-move-history.ts",
    "src/newtab/bookmarks/bookmarks-runtime.ts",
    "src/newtab/bookmarks/bookmarks-store.ts",
    "src/newtab/bookmarks/folder-colors.ts",
    "src/newtab/bookmarks/folder-item-icons.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
