{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/onboarding/**/*.ts",
    "src/popup/**/*.ts",
    "src/newtab/cross-surface-drag.ts",
    "src/newtab/dismiss-stack.ts",
    "src/newtab/drag-click-guard.ts",
    "src/newtab/layout-motion.ts",
    "src/newtab/newtab-types.ts",
    "src/newtab/remote-content.ts",
    "src/newtab/remote-content-types.ts",
    "src/newtab/section-mode-select.ts",
    "src/newtab/storage-change-registry.ts",
    "src/newtab/bookmarks/**/*.ts",
    "src/newtab/recent/**/*.ts",
    "src/newtab/search/**/*.ts",
    "src/newtab/shortcuts/**/*.ts",
    "src/newtab/theme/**/*.ts",
    "src/newtab/top-content/**/*.ts",
    "src/newtab/wallpaper/runtime/custom-wallpapers.ts",
    "src/newtab/wallpaper/runtime/daily-wallpapers.ts",
    "src/newtab/wallpaper/runtime/favicon-chooser.ts",
    "src/newtab/wallpaper/runtime/panel-actions.ts",
    "src/newtab/wallpaper/runtime/panel-motion.ts",
    "src/newtab/wallpaper/runtime/panel-settings.ts",
    "src/newtab/wallpaper/runtime/panel-state.ts",
    "src/newtab/wallpaper/runtime/wallpaper-effect-prefs.ts",
    "src/newtab/wallpaper/runtime/wallpaper-overlay.ts",
    "src/newtab/wallpaper/runtime/wallpaper-runtime-types.ts",
    "src/newtab/wallpaper/runtime/wallpaper-selection.ts",
    "src/newtab/wallpaper/runtime/wallpaper-sources.ts",
    "src/newtab/wallpaper/runtime/wallpaper-storage.ts",
    "src/newtab/wallpaper/runtime/wallpaper-visual.ts",
    "src/newtab/wallpaper/wallpaper-adaptive-tone.ts",
    "src/newtab/wallpaper/wallpaper-crt-webgl.ts",
    "src/newtab/wallpaper/wallpaper-effects.ts",
    "src/newtab/wallpaper/wallpaper-effect-preload.ts",
    "src/newtab/wallpaper/wallpaper-preload.ts",
    "src/newtab/wallpaper/wallpaper-preload-types.ts",
    "src/newtab/wallpaper/wallpaper.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
