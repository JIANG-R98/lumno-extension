{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/onboarding/**/*.ts",
    "src/popup/**/*.ts",
    "src/newtab/cross-surface-drag.ts",
    "src/newtab/dismiss-stack.ts",
    "src/newtab/drag-click-guard.ts",
    "src/newtab/layout-motion.ts",
    "src/newtab/newtab-types.ts",
    "src/newtab/section-mode-select.ts",
    "src/newtab/storage-change-registry.ts",
    "src/newtab/bookmarks/**/*.ts",
    "src/newtab/recent/**/*.ts",
    "src/newtab/search/background-search-focus.ts",
    "src/newtab/search/default-search-engine.ts",
    "src/newtab/search/direct-navigation-settle.ts",
    "src/newtab/search/search-input-composition.ts",
    "src/newtab/search/suggestions-layout.ts",
    "src/newtab/shortcuts/**/*.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
