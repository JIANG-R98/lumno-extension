{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/onboarding/**/*.ts",
    "src/popup/**/*.ts",
    "src/newtab/cross-surface-drag.ts",
    "src/newtab/dismiss-stack.ts",
    "src/newtab/drag-click-guard.ts",
    "src/newtab/layout-motion.ts",
    "src/newtab/newtab-types.ts",
    "src/newtab/remote-content.ts",
    "src/newtab/remote-content-types.ts",
    "src/newtab/section-mode-select.ts",
    "src/newtab/storage-change-registry.ts",
    "src/newtab/bookmarks/**/*.ts",
    "src/newtab/recent/**/*.ts",
    "src/newtab/search/**/*.ts",
    "src/newtab/shortcuts/**/*.ts",
    "src/newtab/theme/**/*.ts",
    "src/newtab/top-content/**/*.ts",
    "src/newtab/wallpaper/wallpaper-crt-webgl.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
