{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/options-types.ts",
    "src/options/options-download.ts",
    "src/options/options-diagnostics.ts",
    "src/options/options-panel-motion.ts",
    "src/options/options-normalizers.ts",
    "src/options/options-navigation.ts",
    "src/options/options-feedback-support.ts",
    "src/options/options-shortcut-reference.ts",
    "src/options/options-theme.ts",
    "src/options/options-translation-help.ts",
    "src/options/options-site-search.ts",
    "src/options/options-site-search-form.ts",
    "src/options/options-search-source-order.ts",
    "src/options/options-site-search-list.ts",
    "src/options/options-site-search-events.ts",
    "src/options/options-aggregate-search.ts",
    "src/options/options-aggregate-search-list.ts",
    "src/options/options-blacklist.ts",
    "src/options/options-blacklist-lists.ts",
    "src/options/options-setting-bindings.ts",
    "src/options/options-toggle-settings.ts",
    "src/options/options-toggle-controls.ts",
    "src/options/options-select-controls.ts",
    "src/options/options-segmented-tabs.ts",
    "src/options/options-slider-controls.ts",
    "src/options/options-control-events.ts",
    "src/options/options-daily-quote.ts",
    "src/options/options-setting-binds.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
