{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/domain/**/*.ts",
    "src/platform/**/*.ts",
    "src/types/**/*.d.ts",
    "src/background/**/*.ts",
    "src/shared/**/*.ts",
    "src/content/**/*.ts",
    "src/overlay/**/*.ts",
    "src/options/**/*.ts",
    "src/onboarding/**/*.ts",
    "src/popup/**/*.ts",
    "src/newtab/cross-surface-drag.ts",
    "src/newtab/dismiss-stack.ts",
    "src/newtab/drag-click-guard.ts",
    "src/newtab/layout-motion.ts",
    "src/newtab/newtab-types.ts",
    "src/newtab/section-mode-select.ts",
    "src/newtab/storage-change-registry.ts",
    "src/newtab/bookmarks/**/*.ts",
    "src/newtab/shortcuts/bottom-dock-runtime.ts",
    "src/newtab/shortcuts/shortcut-context-menu.ts",
    "src/newtab/shortcuts/shortcut-dock.ts",
    "src/newtab/shortcuts/shortcut-icon-plate.ts",
    "src/newtab/shortcuts/shortcut-icon-store.ts",
    "src/newtab/shortcuts/shortcut-page-actions.ts",
    "src/newtab/shortcuts/shortcut-types.ts",
    "src/newtab/shortcuts/shortcuts-controller.ts"
  ],
  "exclude": [
    "src/**/react/**"
  ]
}
